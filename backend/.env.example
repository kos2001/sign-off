# hermes-agent 'sign-off' 프로파일 api_server 연결 설정.
# scripts/setup_hermes_profile.sh --apply 실행 후 생성되는 키를 SIGNOFF_LLM_API_KEY 에 넣는다.
SIGNOFF_LLM_BASE_URL=http://127.0.0.1:8657/v1
SIGNOFF_LLM_API_KEY=
SIGNOFF_LLM_MODEL=sign-off

# Host-local AI review admission (all automatic roles and saved run reviews).
# All API workers on one host must use the same capacity and private directory.
SIGNOFF_REVIEW_MAX_CONCURRENT=2
# SIGNOFF_REVIEW_SLOT_DIR=/var/lib/signoff/review-slots

# Host-local RTL admission shared by workers. Use identical values per host.
SIGNOFF_RTL_MAX_CONCURRENT=2
# local runs tools on the API host; container uses the prebuilt, isolated one-job worker.
SIGNOFF_RTL_EXECUTION=local
SIGNOFF_RTL_WORKER_IMAGE=signoff-rtl-worker:local
# Enable the 60-second expired-container reconciler in container mode.
SIGNOFF_RTL_REAPER_ENABLED=0
# Durable private checkpoint directory (0700); default backend/.rtl-reaper.
# Use the same persistent local directory for API workers in this deployment.
# SIGNOFF_RTL_REAPER_STATE_DIR=/var/lib/signoff/rtl-reaper
# Stable deployment ID; default hashes hostname and backend path (no database credentials).
# SIGNOFF_RTL_WORKER_OWNER=signoff-production
# Optional private directory (0700); default is signoff-rtl-<uid> in the OS temp directory.
# SIGNOFF_RTL_SLOT_DIR=/var/lib/signoff/rtl-slots
